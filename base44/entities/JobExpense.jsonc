{
  "name": "JobExpense",
  "type": "object",
  "properties": {
    "job_id": {
      "description": "Job this actual-cost entry belongs to",
      "type": "string"
    },
    "job_name": {
      "description": "Job name (denormalized)",
      "type": "string"
    },
    "category": {
      "description": "Cost category",
      "enum": [
        "labor",
        "materials",
        "subcontractor",
        "equipment_other"
      ],
      "type": "string"
    },
    "amount": {
      "description": "Actual cost amount in dollars",
      "type": "number"
    },
    "note": {
      "description": "Optional note describing the cost",
      "type": "string"
    },
    "date": {
      "description": "Date of the cost",
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "category",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}