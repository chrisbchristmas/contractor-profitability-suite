{
  "name": "JobAttachment",
  "properties": {
    "category": {
      "default": "other",
      "enum": [
        "contract",
        "permit",
        "photo",
        "invoice",
        "other"
      ],
      "type": "string"
    },
    "change_order_id": {
      "description": "Optional CO this is attached to",
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_type": {
      "description": "mime type",
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "file_url",
    "file_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}