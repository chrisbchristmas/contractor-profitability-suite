{
  "name": "Warranty",
  "type": "object",
  "properties": {
    "job_id": {
      "description": "Job this warranty belongs to",
      "type": "string"
    },
    "job_name": {
      "description": "Job name (denormalized for global view)",
      "type": "string"
    },
    "warranty_type": {
      "description": "Type of warranty",
      "enum": [
        "Labor",
        "Materials",
        "Subcontractor"
      ],
      "type": "string"
    },
    "description": {
      "description": "Description of what is covered",
      "type": "string"
    },
    "start_date": {
      "description": "Warranty start date",
      "format": "date",
      "type": "string"
    },
    "end_date": {
      "description": "Warranty expiry date",
      "format": "date",
      "type": "string"
    },
    "vendor_responsible": {
      "description": "Contractor or vendor responsible for warranty",
      "type": "string"
    },
    "notes": {
      "description": "Additional notes",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "warranty_type",
    "end_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}