{
  "name": "Estimate",
  "properties": {
    "contract_price": {
      "type": "number"
    },
    "estimate_name": {
      "type": "string"
    },
    "estimated_labor_cost": {
      "default": 0,
      "type": "number"
    },
    "estimated_material_cost": {
      "default": 0,
      "type": "number"
    },
    "estimated_overhead": {
      "default": 0,
      "type": "number"
    },
    "estimated_subcontractor_cost": {
      "default": 0,
      "type": "number"
    },
    "risk_level": {
      "enum": [
        "Low Risk",
        "Moderate Risk",
        "High Risk"
      ],
      "type": "string"
    },
    "target_margin_percent": {
      "description": "Target profit margin % for this estimate",
      "type": "number"
    }
  },
  "required": [
    "estimate_name",
    "contract_price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}