{
  "name": "JobTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "description": "Name of this recurring job template",
      "type": "string"
    },
    "trade_type": {
      "description": "Trade or job category (e.g. Roofing, Plumbing, Electrical)",
      "type": "string"
    },
    "description": {
      "description": "Description of the work scope",
      "type": "string"
    },
    "estimated_labor_hours": {
      "description": "Estimated labor hours",
      "type": "number"
    },
    "estimated_labor_cost": {
      "description": "Estimated labor cost in dollars",
      "type": "number"
    },
    "estimated_material_cost": {
      "description": "Estimated material cost in dollars",
      "type": "number"
    },
    "overhead_percent": {
      "description": "Overhead allocation %",
      "type": "number"
    },
    "profit_target_percent": {
      "description": "Target profit margin %",
      "type": "number"
    },
    "notes": {
      "description": "Additional notes or instructions",
      "type": "string"
    }
  },
  "required": [
    "template_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}