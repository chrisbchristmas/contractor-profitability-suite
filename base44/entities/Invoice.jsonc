{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "change_order_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "client_name": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_name": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "line_items": {
      "items": {
        "properties": {
          "amount": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "type": "string"
    },
    "paid_date": {
      "format": "date",
      "type": "string"
    },
    "sent_date": {
      "description": "Date invoice was sent to client",
      "format": "date",
      "type": "string"
    },
    "payment_status": {
      "description": "Payment tracking status",
      "enum": [
        "unpaid",
        "partially_paid",
        "paid",
        "overdue"
      ],
      "default": "unpaid",
      "type": "string"
    },
    "payment_received_date": {
      "description": "Date payment was received",
      "format": "date",
      "type": "string"
    },
    "payment_amount": {
      "description": "Amount of payment received (for partial payments)",
      "type": "number"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue"
      ],
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    }
  },
  "required": [
    "job_id",
    "total_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}