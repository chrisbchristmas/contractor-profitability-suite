{
  "name": "Job",
  "properties": {
    "actual_labor_hours": {
      "description": "Actual labor hours spent",
      "type": "number"
    },
    "assigned_user_id": {
      "description": "Assigned Project Manager user ID",
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_notes": {
      "description": "Notes visible to client on the shared job summary portal",
      "type": "string"
    },
    "completion_date": {
      "description": "Project completion date",
      "format": "date",
      "type": "string"
    },
    "contract_price": {
      "description": "Alias for contract_value",
      "type": "number"
    },
    "contract_value": {
      "type": "number"
    },
    "estimated_cost": {
      "type": "number"
    },
    "estimated_equipment_cost": {
      "description": "Estimated equipment/other cost for variance tracking",
      "type": "number"
    },
    "estimated_labor_cost": {
      "description": "Estimated labor cost (burdened) for variance tracking",
      "type": "number"
    },
    "estimated_labor_hours": {
      "description": "Estimated labor hours for leakage detection",
      "type": "number"
    },
    "estimated_material_cost": {
      "description": "Estimated material cost for variance tracking",
      "type": "number"
    },
    "estimated_remaining_costs": {
      "description": "Estimated remaining costs for profit forecast",
      "type": "number"
    },
    "estimated_subcontractor_cost": {
      "description": "Estimated subcontractor cost for variance tracking",
      "type": "number"
    },
    "job_name": {
      "type": "string"
    },
    "labor_burden_percent": {
      "description": "Per-job override of labor burden % (else falls back to company default)",
      "type": "number"
    },
    "labor_rate": {
      "description": "Hourly labor rate",
      "type": "number"
    },
    "material_cost": {
      "description": "Raw material cost",
      "type": "number"
    },
    "material_markup_percent": {
      "description": "Markup % applied to materials",
      "type": "number"
    },
    "overhead_cost": {
      "description": "Overhead allocated to this job",
      "type": "number"
    },
    "pipeline_status": {
      "description": "Pipeline stage for Kanban board",
      "enum": [
        "Bidding",
        "Active",
        "Punch List",
        "Complete",
        "Invoiced"
      ],
      "default": "Active",
      "type": "string"
    },
    "profit_alerts": {
      "description": "Comma-separated profit leakage / variance alerts",
      "type": "string"
    },
    "profit_per_hour": {
      "type": "number"
    },
    "required_material_markup": {
      "description": "Minimum required material markup %",
      "type": "number"
    },
    "share_token": {
      "description": "Unique unguessable token for public client-facing job summary portal",
      "type": "string"
    },
    "show_co_details": {
      "default": false,
      "description": "Toggle: show change order descriptions and amounts to client",
      "type": "boolean"
    },
    "show_contract_value": {
      "default": false,
      "description": "Toggle: show contract value to client on shared portal",
      "type": "boolean"
    },
    "start_date": {
      "description": "Project start date",
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "active",
      "description": "Alias: job_status",
      "enum": [
        "active",
        "completed"
      ],
      "type": "string"
    },
    "subcontractor_cost": {
      "description": "Subcontractor cost",
      "type": "number"
    },
    "subcontractor_markup_percent": {
      "description": "Markup % applied to subcontractor",
      "type": "number"
    },
    "target_margin_percent": {
      "type": "number"
    },
    "target_profit_per_hour": {
      "description": "Target profit per labor hour (used in health score)",
      "type": "number"
    },
    "total_estimated_hours": {
      "description": "Total estimated labor hours for profit-per-hour",
      "type": "number"
    },
    "true_margin_percent": {
      "description": "Calculated true margin %",
      "type": "number"
    },
    "user_id": {
      "description": "Owner user ID",
      "type": "string"
    },
    "variance_alert_threshold_percent": {
      "description": "Per-job override of the variance alert threshold %",
      "type": "number"
    },
    "wip_pct_complete_override": {
      "description": "Manual % complete override (0-100) for the WIP report; null = use cost-to-cost method",
      "type": "number"
    }
  },
  "required": [
    "job_name",
    "contract_value",
    "estimated_cost"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}