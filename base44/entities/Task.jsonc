{
  "name": "Task",
  "type": "object",
  "properties": {
    "job_id": {
      "description": "Job this task belongs to",
      "type": "string"
    },
    "job_name": {
      "description": "Job name (denormalized)",
      "type": "string"
    },
    "title": {
      "description": "Task title",
      "type": "string"
    },
    "description": {
      "description": "Task description",
      "type": "string"
    },
    "assigned_to": {
      "description": "Person assigned to this task",
      "type": "string"
    },
    "due_date": {
      "description": "Task due date",
      "format": "date",
      "type": "string"
    },
    "status": {
      "description": "Task status",
      "enum": [
        "To Do",
        "In Progress",
        "Done"
      ],
      "default": "To Do",
      "type": "string"
    },
    "priority": {
      "description": "Task priority",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}