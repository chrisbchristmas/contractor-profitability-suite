{
  "name": "SubcontractorPO",
  "type": "object",
  "properties": {
    "po_number": {
      "description": "Auto-generated PO number",
      "type": "string"
    },
    "job_id": {
      "description": "Job this PO is linked to",
      "type": "string"
    },
    "change_order_id": {
      "description": "Optional change order this PO is linked to",
      "type": "string"
    },
    "vendor_name": {
      "description": "Subcontractor or vendor name",
      "type": "string"
    },
    "description": {
      "description": "Description of work",
      "type": "string"
    },
    "po_amount": {
      "description": "PO amount in dollars",
      "type": "number"
    },
    "date_issued": {
      "description": "Date PO was issued",
      "format": "date",
      "type": "string"
    },
    "expected_completion_date": {
      "description": "Expected completion date",
      "format": "date",
      "type": "string"
    },
    "acknowledged_date": {
      "description": "Date vendor acknowledged the PO",
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "description": "PO status",
      "enum": [
        "draft",
        "sent",
        "acknowledged",
        "completed",
        "disputed"
      ],
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "vendor_name",
    "po_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}