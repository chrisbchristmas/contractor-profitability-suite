{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "record_type": {
      "type": "string",
      "description": "Entity type e.g. ChangeOrder, Job"
    },
    "record_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "approve"
      ],
      "description": "What action was taken"
    },
    "field_changed": {
      "type": "string"
    },
    "old_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "changed_by": {
      "type": "string",
      "description": "User email"
    },
    "changed_by_name": {
      "type": "string"
    },
    "changed_by_role": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "record_type",
    "record_id",
    "action",
    "changed_by"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}