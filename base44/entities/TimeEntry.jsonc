{
  "name": "TimeEntry",
  "properties": {
    "change_order_id": {
      "description": "Optional CO this time is tied to",
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "hours": {
      "type": "number"
    },
    "job_id": {
      "type": "string"
    },
    "labor_rate": {
      "type": "number"
    },
    "worker_name": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "hours",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pm"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}